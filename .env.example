# Canonical production origin used for SEO: metadataBase, canonical URLs,
# hreflang alternates, sitemap.xml, robots.txt and absolute Open Graph URLs.
# No trailing slash. Set this to your real domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub Stats module
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: read:user (for GraphQL contribution data)
GITHUB_TOKEN=ghp_personal_access_token_here
GITHUB_USERNAME=github-username
